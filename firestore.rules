rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function canAccess(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.accessUids;
    }

    function canAccessAfter(groupId) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.accessUids;
    }

    function canView(groupId) {
      return signedIn()
        && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public'
          || canAccess(groupId)
        );
    }

    function canWrite(groupId) {
      return signedIn()
        && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public'
          || canAccess(groupId)
        );
    }

    function validInvite(token, groupId) {
      let invite = get(/databases/$(database)/documents/invites/$(token)).data;
      return invite.groupId == groupId
        && invite.active == true
        && invite.expiresAt > request.time;
    }

    function validInviteJoin(groupId) {
      return signedIn()
        && resource.data.visibility == 'private'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accessUids', 'lastInviteRedemption', 'updatedAt'])
        && request.resource.data.lastInviteRedemption.uid == request.auth.uid
        && request.resource.data.accessUids.toSet()
          == resource.data.accessUids.toSet().union([request.auth.uid].toSet())
        && validInvite(request.resource.data.lastInviteRedemption.token, groupId);
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.accessUids;

      allow read: if signedIn()
        && (
          resource.data.visibility == 'public'
          || request.auth.uid in resource.data.accessUids
        );

      allow update: if (
          canAccess(groupId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.accessUids == resource.data.accessUids
        ) || validInviteJoin(groupId)
        || (
          resource.data.visibility == 'public'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.accessUids == resource.data.accessUids
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'members', 'visibility', 'tripStartDate', 'tripEndDate', 'testOffset', 'updatedAt'])
        );

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.ownerUid
          || resource.data.visibility == 'public'
        );

      match /expenses/{expenseId} {
        allow read: if canView(groupId);
        allow write: if canWrite(groupId) || canAccessAfter(groupId);
      }

      match /payments/{paymentId} {
        allow read: if canView(groupId);
        allow write: if canWrite(groupId) || canAccessAfter(groupId);
      }

      match /receipts/{receiptId} {
        allow read: if canView(groupId);

        allow create, update: if (canWrite(groupId) || canAccessAfter(groupId))
          && request.resource.data.keys().hasOnly([
            'dataUrl', 'name', 'contentType', 'size', 'updatedAt'
          ])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 850000
          && request.resource.data.dataUrl.matches('data:image/.*;base64,.*')
          && request.resource.data.contentType is string
          && request.resource.data.contentType.matches('image/.*')
          && request.resource.data.size is int
          && request.resource.data.size <= 563200;

        allow delete: if canWrite(groupId) || canAccessAfter(groupId);
      }
    }

    match /invites/{token} {
      allow get: if signedIn();
      allow list: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.visibility == 'public'
        );

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && canAccess(request.resource.data.groupId)
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.visibility == 'private';

      allow update, delete: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.visibility == 'public'
        );
    }
  }
}
